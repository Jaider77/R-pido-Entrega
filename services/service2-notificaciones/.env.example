# Database
DATABASE_URL=postgresql://notif_user:notif_password@db-notificaciones:5432/notificaciones_db

# Redis
REDIS_URL=redis://redis-cache:6379/2

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq-broker:5672/

# Authentication Service
AUTH_SERVICE_URL=http://auth-service:8000

# Service
SERVICE_NAME=notificaciones
SERVICE_PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@rapido-entrega.com
