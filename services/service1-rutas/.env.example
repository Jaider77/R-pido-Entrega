# Database
DATABASE_URL=postgresql://rutas_user:rutas_password@db-rutas:5432/rutas_db

# Redis
REDIS_URL=redis://redis-cache:6379/1

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq-broker:5672/

